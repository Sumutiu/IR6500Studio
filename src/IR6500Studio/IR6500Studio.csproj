<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>IR6500Studio</RootNamespace>
    <AssemblyName>IR6500Studio</AssemblyName>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>IR6500Studio.Program</StartupObject>

    <!-- Single, self-contained .exe: no extra DLLs, debug info embedded, no .exe.config needed. -->
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Assembly information -->
    <Product>IR6500 Studio</Product>
    <AssemblyTitle>IR6500 Studio</AssemblyTitle>
    <Description>PC-side control software for the ACHI IR6500 rework station (ALTEC PC410 controller).</Description>
    <Company>Marius Sumutiu</Company>
    <Authors>Marius Sumutiu</Authors>
    <Copyright>Copyright © 2026 Marius Sumutiu. All rights reserved.</Copyright>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\app.ico" LogicalName="IR6500Studio.app.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IR6500Studio.Tests" />
  </ItemGroup>

</Project>
